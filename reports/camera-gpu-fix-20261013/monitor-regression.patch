+    def publish_pick_diagnostic(self, frame):
+        """Display the exact measured snapshot, not an overlay on a newer frame."""
+        with self._lock:
+            self._last_pick_diagnostic = frame.copy()
+            self._pick_diagnostic_until = 0.0
+
+    def _predict_yolo(self, image):
+        with self._inference_lock:
+            results = self.model.predict(image, conf=self.conf, iou=0.35,
+                                         imgsz=640, device=self.device, verbose=False)
+            self._limit_yolo_cpu_threads()
+            return results
+
+    def _limit_yolo_cpu_threads(self):
+        # Ultralytics select_device resets Torch's pool during lazy predictor
+        # setup. Apply the UI budget after that first setup, while serialized
+        # by _inference_lock. Subsequent predictions keep this pool size.
+        if self.device == "cpu":
+            import torch
+            if torch.get_num_threads() != 2:
+                torch.set_num_threads(2)
+
+    def pick_scan_session(self):
+        """Pause background inference; all actual camera reads retain _cam_lock."""
+        from contextlib import contextmanager
+
+        @contextmanager
+        def session():
+            with self._pick_scan_lock:
+                self._pick_scan_active.set()
+                try:
+                    yield
+                finally:
+                    self._pick_scan_active.clear()
+        return session()
